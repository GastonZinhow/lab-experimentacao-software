{"name":"Webhook APIs and UI Degraded","status":"resolved","created_at":"2026-05-28T01:13:30.907Z","updated_at":"2026-06-04T15:58:07.348Z","monitoring_at":"2026-05-28T01:27:22.117Z","resolved_at":"2026-05-28T01:32:27.735Z","impact":"minor","shortlink":"https://stspg.io/b3pmwnvwf3my","scheduled_for":null,"scheduled_until":null,"scheduled_remind_prior":false,"scheduled_reminded_at":null,"impact_override":"minor","scheduled_auto_in_progress":false,"scheduled_auto_completed":false,"metadata":{},"started_at":"2026-05-28T01:13:30.895Z","reminder_intervals":null,"id":"f3kmjlk25vhd","page_id":"kctbh9vrtdwd","incident_updates":[{"status":"resolved","body":"On May 28, 2026, between 00:54 UTC and 01:19 UTC, some users experienced errors when interacting with the Webhooks API, including webhook delivery history and configuration endpoints. On average, the error rate was 0.28% and peaked at 0.45%. This was due to a bug that caused a single Kubernetes pod to enter a CrashLoopBackOff after receiving a 500 with an empty response body from Cosmos DB.\u003cbr /\u003e\u003cbr /\u003eWe mitigated the incident by restarting the service. To prevent future incidents, we are pushing a change to handle this response scenario from Cosmos DB appropriately.","created_at":"2026-05-28T01:32:27.735Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-06-04T15:58:07.336Z","display_at":"2026-05-28T01:32:27.735Z","deliver_notifications":true,"tweet_id":null,"id":"7jwkwfwwmzm7","incident_id":"f3kmjlk25vhd","custom_tweet":null,"affected_components":[{"code":"4230lsnqdsld","name":"Webhooks","old_status":"operational","new_status":"operational"}]},{"status":"monitoring","body":"The degradation affecting Webhooks has been mitigated. We are monitoring to ensure stability.","created_at":"2026-05-28T01:27:22.117Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-05-28T01:27:22.117Z","display_at":"2026-05-28T01:27:22.117Z","deliver_notifications":true,"tweet_id