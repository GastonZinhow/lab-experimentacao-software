{"name":"Disruption with some GitHub services","status":"resolved","created_at":"2025-11-17T23:01:06.613Z","updated_at":"2025-11-19T16:39:55.326Z","monitoring_at":null,"resolved_at":"2025-11-18T00:10:50.824Z","impact":"minor","shortlink":"https://stspg.io/x4mn2m8t1ssf","scheduled_for":null,"scheduled_until":null,"scheduled_remind_prior":false,"scheduled_reminded_at":null,"impact_override":"minor","scheduled_auto_in_progress":false,"scheduled_auto_completed":false,"metadata":{},"started_at":"2025-11-17T23:01:06.606Z","reminder_intervals":null,"id":"ql19qqqmdf99","page_id":"kctbh9vrtdwd","incident_updates":[{"status":"resolved","body":"Between November 17, 2025 21:24 UTC and November 18, 2025 00:04 UTC the gists service was degraded and users were unable to create gists via the web UI. 100% of gist creation requests failed with a 404 response. This was due to a change in the web middleware that inadvertently triggered a routing error. We resolved the incident by rolling back the change. We are working on more effective monitoring to reduce the time it takes to detect similar issues and evaluating our testing approach for middleware functionality.","created_at":"2025-11-18T00:10:50.824Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2025-11-19T16:39:55.319Z","display_at":"2025-11-18T00:10:50.824Z","deliver_notifications":true,"tweet_id":null,"id":"0rj7lg59ngll","incident_id":"ql19qqqmdf99","custom_tweet":null,"affected_components":null},{"status":"investigating","body":"We are investigating reports of 404s creating gists.","created_at":"2025-11-17T23:01:13.702Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2025-11-17T23:01:13.702Z","display_at":"2025-11-17T23:01:13.702Z","deliver_notifications":true,"tweet_id":null,"id":"5kfyf2509c3b","incident_id":"ql19qqqmdf99","custom_tweet":null,"affected_components":null},{"status":"investigating","body":"We are currently investigating this issue.","created_at":"2025-11-17T23:01:06.64