{"name":"Disruption with repo creation","status":"resolved","created_at":"2026-01-25T02:43:41.188Z","updated_at":"2026-01-27T01:47:22.795Z","monitoring_at":null,"resolved_at":"2026-01-25T03:08:33.169Z","impact":"minor","shortlink":"https://stspg.io/wtch7mprmscv","scheduled_for":null,"scheduled_until":null,"scheduled_remind_prior":false,"scheduled_reminded_at":null,"impact_override":"minor","scheduled_auto_in_progress":false,"scheduled_auto_completed":false,"metadata":{},"started_at":"2026-01-25T02:43:41.182Z","reminder_intervals":null,"id":"g697qcy5dsks","page_id":"kctbh9vrtdwd","incident_updates":[{"status":"resolved","body":"Between January 24, 2026,19:56 UTC and January 25, 2026, 2:50 UTC repository creation and clone were degraded. On average, the error rate was 25% and peaked at 55% of requests for repository creation. This was due to increased latency on the repositories database impacting a read-after-write problem during repo creation. We mitigated the incident by stopping an operation that was generating load on the database to increase throughput. \u003cbr /\u003e\u003cbr /\u003eWe have identified the repository creation problem and are working to address the issue and improve our observability to reduce our time to detection and mitigation of issues like this one in the future.\u003cbr /\u003e","created_at":"2026-01-25T03:08:33.169Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-01-27T01:47:22.790Z","display_at":"2026-01-25T03:08:33.169Z","deliver_notifications":true,"tweet_id":null,"id":"x8hbp2d9p4vj","incident_id":"g697qcy5dsks","custom_tweet":null,"affected_components":null},{"status":"investigating","body":"The issue has been resolved. We will continue to monitor to ensure stability.","created_at":"2026-01-25T03:08:15.727Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-01-25T03:08:15.727Z","display_at":"2026-01-25T03:08:15.727Z","deliver_notifications":true,"tweet_id":null,"id":"xjrpsmrzv05f","incident_id":"g697qcy5dsks","custom_tweet":null,"affected_components":null},{"status":"investigating","body":"Repo creation failure rate increased above 50%. We have mitigated the problem and are monitoring for recovery.","created_at":"2026-01-25T02:58:02.308Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-01-25T02:58:02.308Z","display_at":"2026-01-25T02:58:02.308Z","deliver_notifications":true,"tweet_id":null,"id":"lyyndb1qd4pz","incident_id":"g697qcy5dsks","custom_tweet":null,"affected_components":null},{"status":"investigating","body":"We are investigating reports of impacted performance for some GitHub services.","created_at":"2026-01-25T02:43:41.228Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-01-25T02:43:41.228Z","display_at":"2026-01-25T02:43:41.228Z","deliver_notifications":true,"tweet_id":null,"id":"4wqb39snnvh2","incident_id":"g697qcy5dsks","custom_tweet":null,"affected_components":null}],"postmortem_body":null,"postmortem_body_last_updated_at":null,"postmortem_ignored":false,"postmortem_published_at":null,"postmortem_notified_subscribers":false,"postmortem_notified_twitter":false,"components":[]}