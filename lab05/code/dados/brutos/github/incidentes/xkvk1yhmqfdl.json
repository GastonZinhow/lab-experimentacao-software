{"name":"Incident with using workflow_dispatch for Actions","status":"resolved","created_at":"2025-11-01T04:43:43.218Z","updated_at":"2025-11-04T23:05:08.450Z","monitoring_at":null,"resolved_at":"2025-11-01T06:14:40.565Z","impact":"minor","shortlink":"https://stspg.io/dqt4twn5km7k","scheduled_for":null,"scheduled_until":null,"scheduled_remind_prior":false,"scheduled_reminded_at":null,"impact_override":"minor","scheduled_auto_in_progress":false,"scheduled_auto_completed":false,"metadata":{},"started_at":"2025-11-01T04:43:43.211Z","reminder_intervals":null,"id":"xkvk1yhmqfdl","page_id":"kctbh9vrtdwd","incident_updates":[{"status":"resolved","body":"On November 1, 2025, between 2:30 UTC and 6:14 UTC, Actions workflows could not be triggered manually from the UI. This impacted all customers queueing workflows from the UI for most of the impact window. The issue was caused by a faulty code change in the UI, which was promptly reverted once the impact was identified. Detection was delayed due to an alerting gap for UI breaks in this area when all underlying APIs are still healthy. We are implementing enhanced alerting and additional automated tests to prevent similar regressions and reduce detection time in the future.","created_at":"2025-11-01T06:14:40.565Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2025-11-04T23:05:08.445Z","display_at":"2025-11-01T06:14:40.565Z","deliver_notifications":true,"tweet_id":null,"id":"07fdb24mlmdd","incident_id":"xkvk1yhmqfdl","custom_tweet":null,"affected_components":[{"code":"br0l2tvcx85d","name":"Actions","old_status":"operational","new_status":"operational"}]},{"status":"investigating","body":"Actions is operating normally.","created_at":"2025-11-01T06:14:38.796Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2025-11-01T06:14:38.796Z","display_at":"2025-11-01T06:14:38.796Z","deliver_notifications":true,"tweet_id":null,"id":"zj15xc2nwqpv","incident_id":"xkvk1yhmqfdl","custom_tweet":null,"a