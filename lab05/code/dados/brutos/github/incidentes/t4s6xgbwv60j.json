Z","display_at":"2026-02-02T20:19:26.636Z","deliver_notifications":true,"tweet_id":null,"id":"5w1mygxb6l34","incident_id":"t4s6xgbwv60j","custom_tweet":null,"affected_components":[{"code":"h2ftsgbw7kmk","name":"Codespaces","old_status":"major_outage","new_status":"major_outage"}]},{"status":"investigating","body":"We are investigating reports of degraded availability for Codespaces","created_at":"2026-02-02T20:17:19.628Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-02-02T20:17:19.628Z","display_at":"2026-02-02T20:17:19.628Z","deliver_notifications":true,"tweet_id":null,"id":"6g3l1qzty651","incident_id":"t4s6xgbwv60j","custom_tweet":null,"affected_components":[{"code":"h2ftsgbw7kmk","name":"Codespaces","old_status":"operational","new_status":"major_outage"}]}],"postmortem_body":null,"postmortem_body_last_updated_at":null,"postmortem_ignored":false,"postmortem_published_at":null,"postmortem_notified_subscribers":false,"postmortem_notified_twitter":false,"components":[{"status":"operational","name":"Codespaces","created_at":"2021-08-11T16:02:09.505Z","updated_at":"2026-07-14T09:51:08.862Z","position":11,"description":"Orchestration and Compute for GitHub Codespaces","showcase":true,"start_date":"2021-08-11T00:00:00.000Z","id":"h2ftsgbw7kmk","page_id":"kctbh9vrtdwd","group_id":null}]}