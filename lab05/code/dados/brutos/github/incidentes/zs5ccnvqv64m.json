{"name":"Incident with Actions","status":"resolved","created_at":"2025-11-19T17:48:17.313Z","updated_at":"2025-11-20T14:19:05.863Z","monitoring_at":null,"resolved_at":"2025-11-19T18:07:20.741Z","impact":"minor","shortlink":"https://stspg.io/grjqjt2bj2dn","scheduled_for":null,"scheduled_until":null,"scheduled_remind_prior":false,"scheduled_reminded_at":null,"impact_override":"minor","scheduled_auto_in_progress":false,"scheduled_auto_completed":false,"metadata":{},"started_at":"2025-11-19T17:48:17.305Z","reminder_intervals":null,"id":"zs5ccnvqv64m","page_id":"kctbh9vrtdwd","incident_updates":[{"status":"resolved","body":"On November 19, between 17:36 UTC and 18:04 UTC, GitHub Actions service experienced degraded performance that caused excessive latency in queueing and updating workflow runs and job statuses. Operations related to artifacts, cache, job steps and logs also had significantly increased latency. At peak, 67% of workflow jobs queued during that timeframe were impacted, and the median latency for impacted operations increased by up to 35x.\u003cbr /\u003e\u003cbr /\u003eThis was caused by a significant change in load pattern on Actions Cache-related operations, leading to a saturated shared resource on the backend. The impact was mitigated by mitigating the new load pattern.\u003cbr /\u003e\u003cbr /\u003eTo reduce the likelihood of a recurrence, we are improving rate-limiting measures in this area to ensure a more consistent experience for all customers.  We are also evaluating changes to reduce the scope of impact.","created_at":"2025-11-19T18:07:20.741Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2025-11-20T14:19:05.858Z","display_at":"2025-11-19T18:07:20.741Z","deliver_notifications":true,"tweet_id":null,"id":"qwnj4kw7ttg2","incident_id":"zs5ccnvqv64m","custom_tweet":null,"affected_components":[{"code":"br0l2tvcx85d","name":"Actions","old_status":"partial_outage","new_status":"operational"}]},{"status":"investigating","body":"We have applied mitigation and are seeing recovery","created_at":"2025-11-19T17:59:26.746Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2025-11-19T17:59:26.746Z","display_at":"2025-11-19T17:59:26.746Z","deliver_notifications":true,"tweet_id":null,"id":"xmjdwy76bxbv","incident_id":"zs5ccnvqv64m","custom_tweet":null,"affected_components":[{"code":"br0l2tvcx85d","name":"Actions","old_status":"partial_outage","new_status":"partial_outage"}]},{"status":"investigating","body":"We are investigating delays in actions runs and possible errors in artifact and cache creation.","created_at":"2025-11-19T17:56:16.432Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2025-11-19T17:56:16.432Z","display_at":"2025-11-19T17:56:16.432Z","deliver_notifications":true,"tweet_id":null,"id":"bkvm9ppqpjtq","incident_id":"zs5ccnvqv64m","custom_tweet":null,"affected_components":[{"code":"br0l2tvcx85d","name":"Actions","old_status":"partial_outage","new_status":"partial_outage"}]},{"status":"investigating","body":"We are investigating reports of degraded performance for Actions","created_at":"2025-11-19T17:48:17.406Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2025-11-19T17:48:17.406Z","display_at":"2025-11-19T17:48:17.406Z","deliver_notifications":true,"tweet_id":null,"id":"k49g9s1rm196","incident_id":"zs5ccnvqv64m","custom_tweet":null,"affected_components":[{"code":"br0l2tvcx85d","name":"Actions","old_status":"operational","new_status":"partial_outage"}]}],"postmortem_body":null,"postmortem_body_last_updated_at":null,"postmortem_ignored":false,"postmortem_published_at":null,"postmortem_notified_subscribers":false,"postmortem_notified_twitter":false,"components":[{"status":"operational","name":"Actions","created_at":"2019-11-13T18:02:19.432Z","updated_at":"2026-11-16T16:07:32.343Z","position":7,"description":"Workflows, Compute and Orchestration for GitHub Actions","showcase":true,"start_date":null,"id":"br0l2tvcx85d","page