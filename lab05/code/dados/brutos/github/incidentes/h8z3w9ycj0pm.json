{"name":"Incident with Copilot","status":"resolved","created_at":"2026-02-23T14:56:09.362Z","updated_at":"2026-03-03T15:36:35.347Z","monitoring_at":null,"resolved_at":"2026-02-23T16:19:33.814Z","impact":"minor","shortlink":"https://stspg.io/crkynbn1mbtt","scheduled_for":null,"scheduled_until":null,"scheduled_remind_prior":false,"scheduled_reminded_at":null,"impact_override":"minor","scheduled_auto_in_progress":false,"scheduled_auto_completed":false,"metadata":{},"started_at":"2026-02-23T14:56:09.356Z","reminder_intervals":null,"id":"h8z3w9ycj0pm","page_id":"kctbh9vrtdwd","incident_updates":[{"status":"resolved","body":"On February 23, 2026, between 14:45 UTC and 16:19 UTC, the Copilot service was degraded for Claude Haiku 4.5 model. On average, 6% of the requests to this model failed due to an issue with an upstream provider. During this period, automated model degradation notifications directed affected users to alternative models. No other models were impacted. The upstream provider identified and resolved the issue on their end. \u003cbr /\u003eWe are working to improve automatic model failover mechanisms to reduce our time to mitigation of issues like this one in the future.","created_at":"2026-02-23T16:19:33.814Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-03-03T15:36:35.342Z","display_at":"2026-02-23T16:19:33.814Z","deliver_notifications":true,"tweet_id":null,"id":"q1h17gpdz6gv","incident_id":"h8z3w9ycj0pm","custom_tweet":null,"affected_components":[{"code":"pjmpxvq2cmr2","name":"Copilot","old_status":"operational","new_status":"operational"}]},{"status":"investigating","body":"Copilot is operating normally.","created_at":"2026-02-23T15:59:59.741Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-02-23T15:59:59.741Z","display_at":"2026-02-23T15:59:59.741Z","deliver_notifications":true,"tweet_id":null,"id":"8q1wtswyxpjf","incident_id":"h8z3w9ycj0pm","custom_tweet":null,"affected_components":[{"code":"pjmpx